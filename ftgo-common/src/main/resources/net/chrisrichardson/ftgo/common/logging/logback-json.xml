<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared structured-logging config: one JSON object per line, MDC (incl. correlationId) included.
     Enable with logging.config=classpath:net/chrisrichardson/ftgo/common/logging/logback-json.xml -->
<configuration>
    <springProperty scope="context" name="service" source="spring.application.name" defaultValue="ftgo"/>
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>
    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
