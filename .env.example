# Local development credentials for docker-compose and the build scripts.
# `set-env.sh` copies this to `.env` (gitignored) on first run, so out-of-the-box
# runs work unchanged. Edit `.env` to use different values; never commit real
# credentials. The DB username is fixed to 'mysqluser' (see mysql/schema.sql);
# only the passwords vary.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=mysqlpw
